{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scheduling-solver-demo",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_flags": ["nodejs_als"],
  "compatibility_date": "2026-09-08",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scheduling-solver-demo",
      // `wrangler d1 create` が出力した実 ID（personal アカウント
      // `zodiac.cancer.j6@gmail.com` の `scheduling-solver-demo`、region APAC）。
      // `database_id` は Wrangler 設定の required 項目であり、秘密ではない
      // （秘密は `wrangler secret put` 側で扱う）。出典:
      // <https://developers.cloudflare.com/workers/wrangler/configuration/>
      // プレースホルダーを置いてデプロイのたびに手で差し替える運用は、書き換え漏れと
      // 戻し忘れの事故を招くのでやめた。別アカウントで動かす場合はここを自分の
      // `wrangler d1 create` の出力へ書き換える。
      "database_id": "f80cd305-94a4-4f23-bd6b-99071af18cb1",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": false,
    },
  ],
}
